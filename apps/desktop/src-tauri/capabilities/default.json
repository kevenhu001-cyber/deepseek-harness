{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main WebView window. Grants the Tauri-side commands the web dist invokes (host info, dialog, notification, OS info) plus the `core:default` set every WebView needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:webview:allow-internal-toggle-devtools",
    "core:app:allow-version",
    "core:app:allow-name",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "os:default",
    "os:allow-platform",
    "os:allow-version",
    "process:default"
  ]
}
